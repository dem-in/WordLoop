@page "/"
@inject TelegramWebApp Telegram

<PageTitle>WordLoop</PageTitle>

<h1>WordLoop</h1>

@if (Telegram.User is { } user)
{
    <p>Привет, @user.DisplayName!</p>
    <p class="hint">Telegram ID: @user.Id</p>
}
else if (Telegram.IsInsideTelegram)
{
    <p>Telegram не передал данные пользователя. Откройте приложение через кнопку меню бота.</p>
}
else
{
    <p>Откройте приложение в Telegram, чтобы прогресс сохранялся.</p>
}

<p class="hint">Скоро здесь будут повторения на сегодня.</p>

@* Placeholder until the review screen exists (slice 2). *@
<MainButton Text="Начать" Enabled="false" OnClick="@(() => { })" />
